# The requirement suite as an image: ghcr.io/<owner>/bifrost-test.
#
# WHY THIS EXISTS: the L3 grace lane runs from a laptop. `scripts/l3-grace.sh`
# cross-compiles the test binaries, copies them over ssh and runs them there,
# which means a deployment can only be validated by somebody holding the repo,
# a Go toolchain and a tunnel — and never on a schedule. This image carries the
# same binaries, so a Job validates the cluster from inside it and a CronJob
# does it nightly without anyone present. `deploy/in-cluster/` has the
# manifests.
#
# WHAT IS IN IT: one binary per requirement package (`go test -c`), the
# `reqreport` traceability tool, and `reqrun`, which runs them in order and
# prints both a summary and the matrix. Nothing else: no source tree (the three
# data files the suite reads — requirements.yaml, targets.yaml,
# permissions.yaml — are `go:embed`ed into the binaries), no shell tooling, no
# kubectl. The pod's ServiceAccount is how it reaches Kubernetes and a mounted
# Secret is how it reaches the API.
#
# Same base and the same non-root arrangement as the server image, for the same
# reasons; see Dockerfile for the commentary on each.

FROM golang@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# The packages to compile are the requirement packages and nothing else, and
# the two exclusions are the ones scripts/l3-grace.sh already makes against a
# real deployment:
#
#   contract — the generated negatives send deliberately malformed bodies; they
#              are L2's job and are verified there.
#   r17_slurm — an AST guard over the source tree, which this image does not
#              carry (and which says nothing about a running cluster).
#
# CGO_ENABLED=0 so the binaries run on ubi-micro, which has no libc the Go
# runtime would otherwise want; -race needs cgo and is an L2 concern.
#
# `-s -w` matters more here than in a single-binary image: each of these links
# the Kubernetes client libraries, and fifteen of them with symbol and DWARF
# tables is most of a gigabyte that a nightly pull would carry for nothing. A
# panic still reports its stack; only the debugger's view is gone.
RUN set -eu; \
    mkdir -p /out/bin; \
    for pkg in $(go list ./test/requirements/... \
        | grep -E '/test/requirements/r[0-9]{2}_[a-z0-9_]+$' \
        | grep -v '/r17_slurm$'); do \
        name=${pkg##*/}; \
        echo "compiling $name"; \
        CGO_ENABLED=0 GOOS=linux GOARCH=$(go env GOARCH) \
            go test -c -trimpath -ldflags "-s -w" -o "/out/bin/$name.test" "$pkg"; \
    done; \
    ls /out/bin

RUN CGO_ENABLED=0 GOOS=linux GOARCH=$(go env GOARCH) \
    go build -trimpath -ldflags "-s -w" -o /out/reqreport ./test/requirements/cmd/reqreport && \
    CGO_ENABLED=0 GOOS=linux GOARCH=$(go env GOARCH) \
    go build -trimpath -ldflags "-s -w" -o /out/reqrun ./test/requirements/cmd/reqrun

RUN printf 'bifrost:x:1001:0:bifrost:/:/sbin/nologin\n' >> /etc/passwd \
 && cp /etc/passwd /out/passwd

# --- runtime -----------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-micro@sha256:f332c99eb8f798a8486821c91937f10ad64ee83d7e739303be2df051040918f6

# The suite talks to an HTTPS API on some deployments (and to Kubernetes, whose
# in-cluster CA arrives on the ServiceAccount mount), so it needs a CA bundle
# for the same reason the server does.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt
COPY --from=build /out/passwd /etc/passwd
COPY --from=build /out/bin/ /usr/local/lib/bifrost-requirements/
COPY --from=build /out/reqreport /usr/local/bin/reqreport
COPY --from=build /out/reqrun /usr/local/bin/reqrun

USER 1001:0

# reqrun writes each package's stream and the report here; a Job that wants to
# keep them mounts a volume over it, and REQ_OUT_DIR moves it.
ENV REQ_OUT_DIR=/tmp/req-out

ENTRYPOINT ["/usr/local/bin/reqrun"]
